            "size": 50001753,
            "width": 1920,
            "height": 1080,
            "duration": 985.501,
            "url": "https://upload.wikimedia.org/wikipedia/commons/e/e2/Wir_senken_die_-Steuer_auf_-Benzin_und_-Diesel%21.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
            "descriptionurl": "https://commons.wikimedia.org/wiki/File:Wir_senken_die_-Steuer_auf_-Benzin_und_-Diesel!.webm",
            "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=118757236",
            "sha1": "bc987fdf4d681632e807015e19ea1090046bfcde",
            "extmetadata": {
              "ObjectName": {
                "value": "Wir senken die -Steuer auf -Benzin und -Diesel!",
                "source": "mediawiki-metadata"
